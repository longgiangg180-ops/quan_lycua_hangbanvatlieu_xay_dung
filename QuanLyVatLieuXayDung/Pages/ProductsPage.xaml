<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="QuanLyVatLieuXayDung.Pages.ProductsPage"
    Title="Sản phẩm"
    BackgroundColor="#F3F4F6">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">
            <VerticalStackLayout Spacing="5">
                <Label Text="Quản lý sản phẩm"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#172554" />
                <Label Text="Danh sách vật liệu xây dựng trong cửa hàng"
                       FontSize="14"
                       TextColor="#64748B" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Entry Placeholder="Tìm kiếm sản phẩm..."
                       BackgroundColor="White"
                       TextColor="#1E293B"
                       PlaceholderColor="#94A3B8"
                       HeightRequest="48" />
                <Button Grid.Column="1"
                        Text="+ Thêm sản phẩm"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        CornerRadius="8" />
            </Grid>

            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 10"
                    Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Danh sách sản phẩm"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#172554" />
                    <Label Text="Chưa có dữ liệu sản phẩm."
                           FontSize="14"
                           TextColor="#64748B"
                           HorizontalOptions="Center"
                           Margin="0,20" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
