<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuanLyVatLieuXayDung.Views.StatisticsView">

    <ScrollView x:Name="MainScrollView">

        <VerticalStackLayout Padding="10"
                             Spacing="20">

            <!-- TIÊU ĐỀ -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Thống kê doanh thu"
                       FontSize="23"
                       FontAttributes="Bold"
                       TextColor="#172554"/>

                <Label Text="Theo dõi doanh thu và lịch sử hóa đơn theo tháng"
                       FontSize="14"
                       TextColor="#6B7280"/>
            </VerticalStackLayout>

            <!-- CHỌN THÁNG -->
            <Border BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    Padding="18"
                    StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="10">

                    <Label Text="📅 Chọn tháng thống kê"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#374151"/>

                    <Picker x:Name="MonthPicker"
                            Title="Chọn tháng/năm"
                            FontSize="15"
                            TextColor="#172554"
                            SelectedIndexChanged="OnMonthChanged"/>

                    <Label Text="Doanh thu được tính theo số tiền thực tế khách hàng thanh toán."
                           FontSize="12"
                           TextColor="#9CA3AF"/>

                </VerticalStackLayout>
            </Border>

            <!-- TỔNG DOANH THU -->
            <Border BackgroundColor="#EFF6FF"
                    Stroke="#BFDBFE"
                    StrokeThickness="1"
                    Padding="22"
                    StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="12">

                    <Label Text="💰 TỔNG DOANH THU THÁNG"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#1E40AF"/>

                    <Label x:Name="MonthlyRevenueLabel"
                           Text="Đang tải..."
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="#2563EB"/>

                    <BoxView HeightRequest="1"
                             Color="#BFDBFE"/>

                    <Label x:Name="SelectedMonthLabel"
                           Text="Tháng thống kê"
                           FontSize="13"
                           TextColor="#1E40AF"/>

                </VerticalStackLayout>
            </Border>

            <!-- TỔNG SỐ HÓA ĐƠN -->
            <Border BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    Padding="18"
                    StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="8">

                    <Label Text="🧾 Số hóa đơn trong tháng"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#6B7280"/>

                    <Label x:Name="InvoiceCountLabel"
                           Text="0"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#059669"/>

                </VerticalStackLayout>
            </Border>

            <!-- DANH SÁCH HÓA ĐƠN -->
            <VerticalStackLayout x:Name="InvoiceSection"
                                 Spacing="12">

                <BoxView HeightRequest="1"
                         Color="#E5E7EB"/>

                <Label Text="LỊCH SỬ HÓA ĐƠN"
                       FontSize="19"
                       FontAttributes="Bold"
                       TextColor="#172554"/>

                <Label x:Name="InvoiceListDescription"
                       Text="Danh sách hóa đơn"
                       FontSize="13"
                       TextColor="#6B7280"/>

                <VerticalStackLayout x:Name="InvoiceListLayout"
                                     Spacing="12"/>

                <Label x:Name="EmptyInvoiceLabel"
                       Text="Không có hóa đơn trong tháng này."
                       FontSize="14"
                       TextColor="#9CA3AF"
                       HorizontalOptions="Center"
                       IsVisible="False"/>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentView>
