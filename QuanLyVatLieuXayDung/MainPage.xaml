<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuanLyVatLieuXayDung.MainPage"
             BackgroundColor="#F3F4F6">

    <Grid ColumnDefinitions="240,*">

        <!-- MENU BÊN TRÁI -->
        <VerticalStackLayout Grid.Column="0"
                             BackgroundColor="#172554"
                             Padding="20,30"
                             Spacing="20">

            <Label Text="VLXD MANAGER"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"/>

            <Label Text="QUẢN LÝ CỬA HÀNG"
                   FontSize="11"
                   TextColor="#BFDBFE"
                   HorizontalOptions="Center"/>

            <BoxView HeightRequest="1"
                     Color="#475569"
                     Margin="0,10"/>

            <Button x:Name="HomeButton"
                    Text="Trang chủ"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    HorizontalOptions="Fill"
                    CornerRadius="8"
                    Clicked="OnHomeClicked"/>

            <Button x:Name="ProductsButton"
                    Text="Sản phẩm"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    HorizontalOptions="Fill"
                    CornerRadius="8"
                    Clicked="OnProductsClicked"/>

            <Button x:Name="CustomersButton"
                    Text="Khách hàng"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    HorizontalOptions="Fill"
                    CornerRadius="8"
                    Clicked="OnCustomersClicked"/>

            <Button x:Name="SuppliersButton"
                    Text="Nhà cung cấp"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    HorizontalOptions="Fill"
                    CornerRadius="8"
                    Clicked="OnSuppliersClicked"/>

            <Button x:Name="InvoicesButton"
                    Text="Hóa đơn"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    HorizontalOptions="Fill"
                    CornerRadius="8"
                    Clicked="OnInvoicesClicked"/>

            <Button x:Name="StatisticsButton"
                    Text="Thống kê"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    HorizontalOptions="Fill"
                    CornerRadius="8"
                    Clicked="OnStatisticsClicked"/>

        </VerticalStackLayout>

        <!-- KHU VỰC NỘI DUNG -->
        <Grid Grid.Column="1"
              RowDefinitions="70,*"
              Padding="25">

            <!-- TIÊU ĐỀ -->
            <Label x:Name="PageTitle"
                   Grid.Row="0"
                   Text="Tổng quan"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#172554"
                   VerticalOptions="Center"/>

            <!-- NỘI DUNG TRANG CHỦ -->
            <ContentView x:Name="PageContent"
                         Grid.Row="1">

                <ScrollView>

                    <VerticalStackLayout Spacing="20">

                        <!-- ẢNH CỬA HÀNG -->
                        <Border BackgroundColor="White"
                                Stroke="#E5E7EB"
                                StrokeThickness="1"
                                Padding="5"
                                StrokeShape="RoundRectangle 14">

                            <Image Source="anhcuahang.jpg"
                                   HeightRequest="220"
                                   Aspect="AspectFill"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill"/>
                        </Border>

                        <!-- LỜI CHÀO -->
                        <VerticalStackLayout Spacing="8">

                            <Label Text="Chào mừng đến với Cửa Hàng Xây Dựng Công Ty Gà Rán!"
                                   FontSize="23"
                                   FontAttributes="Bold"
                                   TextColor="#172554"/>

                            <Label Text="Hệ thống quản lý cửa hàng vật liệu xây dựng"
                                   FontSize="15"
                                   TextColor="#6B7280"/>

                        </VerticalStackLayout>

                        <!-- TIÊU ĐỀ THỐNG KÊ -->
                        <Label Text="Tổng quan hoạt động kinh doanh"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#374151"/>

                        <!-- BA THẺ THỐNG KÊ -->
                        <Grid ColumnDefinitions="*,*,*"
                              ColumnSpacing="15">

                            <!-- TỔNG SẢN PHẨM -->
                            <Border Grid.Column="0"
                                    BackgroundColor="White"
                                    Stroke="#E5E7EB"
                                    StrokeThickness="1"
                                    Padding="18"
                                    StrokeShape="RoundRectangle 12">

                                <VerticalStackLayout Spacing="12">

                                    <Label Text="📦 Tổng sản phẩm"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#6B7280"/>

                                    <Label x:Name="TotalProductsLabel"
                                           Text="Đang tải..."
                                           FontSize="30"
                                           FontAttributes="Bold"
                                           TextColor="#2563EB"/>

                                    <Label Text="Sản phẩm trong hệ thống"
                                           FontSize="12"
                                           TextColor="#9CA3AF"/>

                                </VerticalStackLayout>
                            </Border>

                            <!-- HÓA ĐƠN HÔM NAY -->
                            <Border Grid.Column="1"
                                    BackgroundColor="White"
                                    Stroke="#E5E7EB"
                                    StrokeThickness="1"
                                    Padding="18"
                                    StrokeShape="RoundRectangle 12">

                                <VerticalStackLayout Spacing="12">

                                    <Label Text="🧾 Hóa đơn hôm nay"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#6B7280"/>

                                    <Label x:Name="TodayInvoicesLabel"
                                           Text="Đang tải..."
                                           FontSize="30"
                                           FontAttributes="Bold"
                                           TextColor="#059669"/>

                                    <Label Text="Hóa đơn được lập hôm nay"
                                           FontSize="12"
                                           TextColor="#9CA3AF"/>

                                </VerticalStackLayout>
                            </Border>

                            <!-- DOANH THU HÔM NAY -->
                            <Border Grid.Column="2"
                                    BackgroundColor="White"
                                    Stroke="#E5E7EB"
                                    StrokeThickness="1"
                                    Padding="18"
                                    StrokeShape="RoundRectangle 12">

                                <VerticalStackLayout Spacing="12">

                                    <Label Text="💰 Doanh thu hôm nay"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#6B7280"/>

                                    <Label x:Name="TodayRevenueLabel"
                                           Text="Đang tải..."
                                           FontSize="25"
                                           FontAttributes="Bold"
                                           TextColor="#EA580C"/>

                                    <Label Text="Tổng tiền thanh toán hôm nay"
                                           FontSize="12"
                                           TextColor="#9CA3AF"/>

                                </VerticalStackLayout>
                            </Border>

                        </Grid>

                        <!-- THÔNG TIN BỔ SUNG -->
                        <Border BackgroundColor="White"
                                Stroke="#E5E7EB"
                                StrokeThickness="1"
                                Padding="18"
                                StrokeShape="RoundRectangle 12">

                            <VerticalStackLayout Spacing="8">

                                <Label Text="Cửa Hàng Xây Dựng Công Ty Gà Rán"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="#172554"/>

                                <Label Text="Phần mềm hỗ trợ quản lý sản phẩm, khách hàng, nhà cung cấp, hóa đơn và hoạt động kinh doanh của cửa hàng."
                                       FontSize="14"
                                       TextColor="#6B7280"/>

                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                </ScrollView>

            </ContentView>

        </Grid>

    </Grid>

</ContentPage>
