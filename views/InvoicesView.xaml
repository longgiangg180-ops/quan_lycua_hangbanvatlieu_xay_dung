<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuanLyVatLieuXayDung.Views.InvoicesView">

    <Grid ColumnDefinitions="3*,2*" ColumnSpacing="20">

        <!-- CỘT TRÁI: LẬP HÓA ĐƠN & CHI TIẾT BÁN HÀNG -->
        <Border Grid.Column="0"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="16">

            <ScrollView>
                <VerticalStackLayout Spacing="14">

                    <Label Text="TẠO HÓA ĐƠN BÁN HÀNG MỚI"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1E293B" />

                    <!-- CHỌN KHÁCH HÀNG & PHƯƠNG THỨC -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Khách hàng (*):" FontSize="13" FontAttributes="Bold" TextColor="#334155"/>
                            <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="6,0">
                                <Picker x:Name="CustomerPicker" Title="-- Chọn khách hàng --" ItemDisplayBinding="{Binding TenKhachHang}"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Hình thức thanh toán:" FontSize="13" FontAttributes="Bold" TextColor="#334155"/>
                            <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="6,0">
                                <Picker x:Name="PaymentMethodPicker" SelectedIndex="0">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Tiền mặt</x:String>
                                            <x:String>Chuyển khoản</x:String>
                                            <x:String>QR Code</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,4"/>

                    <!-- CHỌN SẢN PHẨM & SỐ LƯỢNG MUA (CHỨC NĂNG 3 & 5) -->
                    <Label Text="Thêm sản phẩm vào đơn" FontSize="15" FontAttributes="Bold" TextColor="#2563EB"/>

                    <Grid ColumnDefinitions="2*,1*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Chọn sản phẩm:" FontSize="12" TextColor="#64748B"/>
                            <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="6,0">
                                <Picker x:Name="ProductPicker"
                                        Title="-- Chọn sản phẩm --"
                                        ItemDisplayBinding="{Binding TenSanPham}"
                                        SelectedIndexChanged="OnProductPickerChanged"/>
                            </Border>
                            <!-- Nhãn hiển thị số lượng tồn kho theo thời gian thực -->
                            <Label x:Name="StockLabel" Text="Tồn kho: --" FontSize="12" FontAttributes="Bold" TextColor="#059669"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Số lượng:" FontSize="12" TextColor="#64748B"/>
                            <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="8,0">
                                <Entry x:Name="QuantityEntry" Text="1" Keyboard="Numeric" />
                            </Border>
                            <Label x:Name="PriceLabel" Text="Đơn giá: --" FontSize="12" TextColor="#64748B"/>
                        </VerticalStackLayout>

                        <Button Grid.Column="2"
                                Text="+ Thêm món"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="6"
                                VerticalOptions="Center"
                                Padding="14,10"
                                Clicked="OnAddProductToCartClicked"/>
                    </Grid>

                    <!-- DANH SÁCH CHI TIẾT HÓA ĐƠN (CHỨC NĂNG 3 & 4) -->
                    <Label Text="Chi tiết đơn hàng:" FontSize="14" FontAttributes="Bold" TextColor="#334155" Margin="0,5,0,0"/>

                    <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="8">
                        <VerticalStackLayout Spacing="6">
                            <!-- Tiêu đề cột -->
                            <Grid ColumnDefinitions="3*,1*,2*,2*,40" BackgroundColor="#F8FAFC" Padding="6,8">
                                <Label Grid.Column="0" Text="Sản phẩm" FontAttributes="Bold" FontSize="12" TextColor="#334155"/>
                                <Label Grid.Column="1" Text="SL" FontAttributes="Bold" FontSize="12" TextColor="#334155" HorizontalOptions="Center"/>
                                <Label Grid.Column="2" Text="Đơn giá" FontAttributes="Bold" FontSize="12" TextColor="#334155" HorizontalOptions="End"/>
                                <Label Grid.Column="3" Text="Thành tiền" FontAttributes="Bold" FontSize="12" TextColor="#334155" HorizontalOptions="End"/>
                                <Label Grid.Column="4" Text="" />
                            </Grid>

                            <!-- Danh sách món đã thêm -->
                            <CollectionView x:Name="CartItemsCollection" HeightRequest="160" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="3*,1*,2*,2*,40" Padding="6,6">
                                            <Label Grid.Column="0" Text="{Binding TenSanPham}" FontSize="12" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                                            <Label Grid.Column="1" Text="{Binding SoLuong}" FontSize="12" VerticalOptions="Center" HorizontalOptions="Center" FontAttributes="Bold"/>
                                            <Label Grid.Column="2" Text="{Binding DonGiaBan, StringFormat='{0:N0} đ'}" FontSize="12" VerticalOptions="Center" HorizontalOptions="End" TextColor="#64748B"/>
                                            <Label Grid.Column="3" Text="{Binding ThanhTien, StringFormat='{0:N0} đ'}" FontSize="12" VerticalOptions="Center" HorizontalOptions="End" FontAttributes="Bold" TextColor="#2563EB"/>
                                            <Button Grid.Column="4" Text="✕" FontSize="11" TextColor="#EF4444" BackgroundColor="Transparent" Padding="0" Clicked="OnRemoveCartItemClicked" CommandParameter="{Binding .}"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <!-- KHU VỰC TỔNG TIỀN & THANH TOÁN (CHỨC NĂNG 4 & 5) -->
                    <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="14">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8">

                            <Label Grid.Row="0" Grid.Column="0" Text="Tổng tiền hàng:" FontSize="14" TextColor="#64748B" VerticalOptions="Center"/>
                            <Label Grid.Row="0" Grid.Column="1" x:Name="TotalAmountLabel" Text="0 đ" FontSize="16" FontAttributes="Bold" TextColor="#1E293B"/>

                            <Label Grid.Row="1" Grid.Column="0" Text="Giảm giá (VNĐ):" FontSize="14" TextColor="#64748B" VerticalOptions="Center"/>
                            <Border Grid.Row="1" Grid.Column="1" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 6" WidthRequest="120" Padding="6,0">
                                <Entry x:Name="DiscountEntry" Text="0" Keyboard="Numeric" HorizontalTextAlignment="End" TextChanged="OnDiscountChanged"/>
                            </Border>

                            <Label Grid.Row="2" Grid.Column="0" Text="KHÁCH PHẢI TRẢ:" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center"/>
                            <Label Grid.Row="2" Grid.Column="1" x:Name="FinalPaymentLabel" Text="0 đ" FontSize="20" FontAttributes="Bold" TextColor="#DC2626"/>

                        </Grid>
                    </Border>

                    <!-- NÚT THANH TOÁN & TRỪ TỒN KHO -->
                    <Button Text="✓ XÁC NHẬN THANH TOÁN &amp; XUẤT HÓA ĐƠN"
                            BackgroundColor="#10B981"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="8"
                            HeightRequest="48"
                            Clicked="OnSubmitInvoiceClicked"/>

                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- CỘT PHẢI: LỊCH SỬ CÁC HÓA ĐƠN ĐÃ LẬP -->
        <Border Grid.Column="1"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="16">

            <Grid RowDefinitions="Auto,*">
                <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,10">
                    <Label Text="LỊCH SỬ HÓA ĐƠN" FontSize="16" FontAttributes="Bold" TextColor="#1E293B"/>
                    <Label Text="Danh sách các hóa đơn đã bán" FontSize="12" TextColor="#64748B"/>
                </VerticalStackLayout>

                <CollectionView Grid.Row="1" x:Name="InvoicesHistoryCollection" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F8FAFC" Padding="12" Margin="0,0,0,8">
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                                    <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="8">
                                        <Label Text="{Binding MaHoaDon, StringFormat='HĐ #{0}'}" FontAttributes="Bold" TextColor="#2563EB" FontSize="14"/>
                                        <Label Text="{Binding TenKhachHang}" FontAttributes="Bold" TextColor="#334155" FontSize="13"/>
                                    </HorizontalStackLayout>
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding ThanhToan, StringFormat='{0:N0} đ'}" FontAttributes="Bold" TextColor="#059669" FontSize="14"/>

                                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding NgayLap, StringFormat='{0:dd/MM/yyyy HH:mm}'}" TextColor="#94A3B8" FontSize="11"/>
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding PhuongThucThanhToan}" TextColor="#64748B" FontSize="11"/>

                                    <Button Grid.Row="2" Grid.ColumnSpan="2"
                                            Text="Xem chi tiết đơn"
                                            FontSize="12"
                                            BackgroundColor="#E0E7FF"
                                            TextColor="#3730A3"
                                            Padding="0"
                                            HeightRequest="28"
                                            CornerRadius="4"
                                            Margin="0,4,0,0"
                                            Clicked="OnViewInvoiceDetailClicked"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

    </Grid>

</ContentView>
