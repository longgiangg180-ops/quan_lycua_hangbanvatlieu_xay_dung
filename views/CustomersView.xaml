<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuanLyVatLieuXayDung.Views.CustomersView">

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="2*,1*" ColumnSpacing="20" RowSpacing="15">

        <!-- THANH CÔNG CỤ TÌM KIẾM -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="White" Padding="10,0">
                <Entry x:Name="SearchEntry"
                       Placeholder="Tìm kiếm theo Tên, SĐT hoặc Địa chỉ..."
                       TextChanged="OnSearchTextChanged"
                       VerticalOptions="Center" />
            </Border>

            <Button Grid.Column="1"
                    Text="Tìm kiếm"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    CornerRadius="8"
                    Padding="20,10"
                    Clicked="OnSearchClicked" />

            <Button Grid.Column="2"
                    Text="Làm mới"
                    BackgroundColor="#64748B"
                    TextColor="White"
                    CornerRadius="8"
                    Padding="15,10"
                    Clicked="OnRefreshClicked" />
        </Grid>

        <!-- BẢNG DANH SÁCH KHÁCH HÀNG (CỘT TRÁI) -->
        <Border Grid.Row="1" Grid.Column="0"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="15">

            <Grid RowDefinitions="Auto,*">
                <!-- Tiêu đề bảng -->
                <Grid Grid.Row="0" ColumnDefinitions="60,2*,1.5*,2*,120" BackgroundColor="#F1F5F9" Padding="10,12">
                    <Label Grid.Column="0" Text="Mã" FontAttributes="Bold" TextColor="#1E293B"/>
                    <Label Grid.Column="1" Text="Tên khách hàng" FontAttributes="Bold" TextColor="#1E293B"/>
                    <Label Grid.Column="2" Text="Số điện thoại" FontAttributes="Bold" TextColor="#1E293B"/>
                    <Label Grid.Column="3" Text="Địa chỉ" FontAttributes="Bold" TextColor="#1E293B"/>
                    <Label Grid.Column="4" Text="Thao tác" FontAttributes="Bold" TextColor="#1E293B" HorizontalOptions="Center"/>
                </Grid>

                <!-- Danh sách dữ liệu -->
                <CollectionView Grid.Row="1" x:Name="CustomersCollection" SelectionMode="None" Margin="0,5,0,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="60,2*,1.5*,2*,120" Padding="10,12">
                                <Label Grid.Column="0" Text="{Binding MaKhachHang}" VerticalOptions="Center" TextColor="#475569"/>
                                <Label Grid.Column="1" Text="{Binding TenKhachHang}" FontAttributes="Bold" VerticalOptions="Center" TextColor="#0F172A"/>
                                <Label Grid.Column="2" Text="{Binding SoDienThoai}" VerticalOptions="Center" TextColor="#2563EB"/>
                                <Label Grid.Column="3" Text="{Binding DiaChi}" VerticalOptions="Center" TextColor="#475569" LineBreakMode="TailTruncation"/>

                                <HorizontalStackLayout Grid.Column="4" Spacing="6" HorizontalOptions="Center">
                                    <Button Text="Sửa"
                                            FontSize="12"
                                            Padding="8,4"
                                            HeightRequest="32"
                                            BackgroundColor="#0EA5E9"
                                            TextColor="White"
                                            CornerRadius="4"
                                            Clicked="OnEditCustomerClicked"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Xóa"
                                            FontSize="12"
                                            Padding="8,4"
                                            HeightRequest="32"
                                            BackgroundColor="#EF4444"
                                            TextColor="White"
                                            CornerRadius="4"
                                            Clicked="OnDeleteCustomerClicked"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <!-- FORM THÊM / CẬP NHẬT KHÁCH HÀNG (CỘT PHẢI) -->
        <Border Grid.Row="1" Grid.Column="1"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="20">

            <VerticalStackLayout Spacing="15">
                <Label x:Name="FormTitleLabel"
                       Text="Thêm khách hàng mới"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#0F172A" />

                <!-- Mã KH (ẩn/chỉ đọc khi sửa) -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Mã khách hàng (tự động):" FontSize="13" TextColor="#64748B"/>
                    <Entry x:Name="MaKhachHangEntry" IsReadOnly="True" Placeholder="Tự động sinh mã" BackgroundColor="#F8FAFC"/>
                </VerticalStackLayout>

                <!-- Tên KH -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Tên khách hàng (*):" FontSize="13" TextColor="#1E293B" FontAttributes="Bold"/>
                    <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="8,0">
                        <Entry x:Name="TenKhachHangEntry" Placeholder="Nhập họ và tên..." />
                    </Border>
                </VerticalStackLayout>

                <!-- Số điện thoại -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Số điện thoại (*):" FontSize="13" TextColor="#1E293B" FontAttributes="Bold"/>
                    <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="8,0">
                        <Entry x:Name="SoDienThoaiEntry" Placeholder="Nhập số điện thoại (10-11 số)..." Keyboard="Telephone"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Địa chỉ -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Địa chỉ (*):" FontSize="13" TextColor="#1E293B" FontAttributes="Bold"/>
                    <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="8,0">
                        <Entry x:Name="DiaChiEntry" Placeholder="Nhập địa chỉ..." />
                    </Border>
                </VerticalStackLayout>

                <!-- Nút lưu và hủy -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                    <Button x:Name="SaveButton"
                            Grid.Column="0"
                            Text="Lưu lại"
                            BackgroundColor="#10B981"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="6"
                            Clicked="OnSaveCustomerClicked"/>

                    <Button Grid.Column="1"
                            Text="Hủy / Mới"
                            BackgroundColor="#94A3B8"
                            TextColor="White"
                            CornerRadius="6"
                            Clicked="OnClearFormClicked"/>
                </Grid>

            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentView>
